# Copy this to .env and adjust as needed
# docker compose will pick this up automatically

# Port exposed on your host for the backend API
BACKEND_PORT=8080

# Port exposed on your host for the frontend
FRONTEND_PORT=3000

# Backend URL as seen from the BROWSER (not inside Docker)
# Change this if you're running on a remote server
VITE_BACKEND_URL=http://localhost:8080
